<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.master.cs" Inherits="LittleNewton.Web.Admin1" %>

<!DOCTYPE html>

<!--[if IE 8]>         <html class="ie8"> <![endif]-->
<!--[if IE 9]>         <html class="ie9 gt-ie8"> <![endif]-->
<!--[if gt IE 9]><!--> <html class="gt-ie8 gt-ie9 not-ie"> <!--<![endif]-->
<head>
	<meta charset="utf-8">
	<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
	<title>Little Newton - Administration</title>
	<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0">

	<!-- Open Sans font from Google CDN -->
	<%--<link href="https://fonts.googleapis.com/css?family=Open+Sans:300italic,400italic,600italic,700italic,400,600,700,300&subset=latin" rel="stylesheet" type="text/css">--%>

    <link href="assets/stylesheets/fonts.css" rel="stylesheet" type="text/css">

	<!-- Pixel Admin's stylesheets -->
	<link href="/assets/stylesheets/bootstrap.min.css" rel="stylesheet" type="text/css">
	<link href="/assets/stylesheets/pixel-admin.min.css" rel="stylesheet" type="text/css">
	<link href="/assets/stylesheets/widgets.min.css" rel="stylesheet" type="text/css">
	<link href="/assets/stylesheets/rtl.min.css" rel="stylesheet" type="text/css">
	<link href="/assets/stylesheets/themes.min.css" rel="stylesheet" type="text/css">
    <link href="/assets/Content/css/custom.css" rel="stylesheet" type="text/css"/>
    
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>

	<!--[if lt IE 9]>
		<script src="/assets/javascripts/ie.min.js"></script>
	<![endif]-->
</head>

<!--<body class="theme-default main-menu-animated">-->
<body class="theme-white  main-menu-animated dont-animate-mm-content-sm animate-mm-md animate-mm-lg">

    <form id="form1" runat="server"> 
        <script>var init = [];</script>

        <div id="main-wrapper">

	        <div id="main-navbar" class="navbar navbar-inverse" role="navigation">
		        <!-- Main menu toggle -->
		        <button type="button" id="main-menu-toggle"><i class="navbar-icon fa fa-bars icon"></i><span class="hide-menu-text">HIDE MENU</span></button>
		
		        <div class="navbar-inner">
			        <!-- Main navbar header -->
			        <div class="navbar-header">

				        <!-- Logo -->
				        <div class="navbar-brand">
					        <img class="img-responsive" src="../assets/images/littlenewton-logo.png">
				        </div>
				        <!-- Main navbar toggle -->
				        <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#main-navbar-collapse"><i class="navbar-icon fa fa-bars"></i></button>

			        </div> <!-- / .navbar-header -->

			        <div id="main-navbar-collapse" class="collapse navbar-collapse main-navbar-collapse">
				        <div>
					        <ul class="nav navbar-nav">
						        <li>
							        <a href="#"><i class="menu-icon fa fa-desktop" ></i><span class="mm-text">&nbsp;VIDEOS</span></a>
						        </li>
                                <li>
							        <a href="#"><i class="menu-icon fa fa-bar-chart-o" ></i><span class="mm-text">&nbsp;REPORTS</span></a>
						        </li>
					        </ul> 
                            
					        <div class="right clearfix">
						        <ul class="nav navbar-nav pull-right right-navbar-nav">
                                    <li class="nav-icon-btn nav-icon-btn-success dropdown">
								        <a href="#messages" class="dropdown-toggle" data-toggle="dropdown">
									        <span class="label"><%= MessageCount %></span>
									        <i class="nav-icon fa fa-envelope"></i>
									        <span class="small-screen-text">Income messages</span>
								        </a>

								        <!-- MESSAGES -->
								
								        <!-- Javascript -->
								        <script>
								            init.push(function () {
								                $('#main-navbar-messages').slimScroll({ height: 250 });
								            });
								        </script>
								        <!-- / Javascript -->

								        <div class="dropdown-menu widget-messages-alt no-padding" style="width: 300px;">
									        <div class="slimScrollDiv" style="position: relative; overflow: hidden; width: auto; height: 250px;"><div class="messages-list" id="main-navbar-messages" style="overflow: hidden; width: auto; height: 250px;">
                                                <asp:Repeater ID="rpList" runat="server">
                                                    <ItemTemplate>
                                                        <div class="message">
											                <img src="../assets/images/rc-images/profile_1.png" alt="" class="message-avatar">
                                                            <asp:LinkButton ID="lnkOpen" runat="server" CssClass="message-subject" Text='<%# Eval("SubjectShort") %>' OnClick="Transaction_Click" CommandName="Open" CommandArgument='<%# Eval("ID")%>'></asp:LinkButton>
											                <div class="message-description">
												                from <a href="#"><%# Eval("MessageFrom") %></a>
												                &nbsp;&nbsp;·&nbsp;&nbsp;
												                <%# Eval("DateCreated","{0:d}") %>
											                </div>
										                </div> <!-- / .message -->
                                                    </ItemTemplate>
                                                </asp:Repeater>
										        
									        
                                            </div><div class="slimScrollBar" style="background: rgb(0, 0, 0); width: 7px; position: absolute; top: 0px; opacity: 0.4; display: none; border-radius: 7px; z-index: 99; right: 1px; height: 109.842px;"></div><div class="slimScrollRail" style="width: 7px; height: 100%; position: absolute; top: 0px; display: none; border-radius: 7px; background: rgb(51, 51, 51); opacity: 0.2; z-index: 90; right: 1px;"></div></div> <!-- / .messages-list -->
									        <a href="admin-messages" class="messages-link">MORE MESSAGES</a>
								        </div> <!-- / .dropdown-menu -->
                                        
							        </li>
                                    <li>
                                        <a href="admin-change-password" id="A2"><i class="menu-icon fa fa-key" title="Change Password"></i></a>
                                    </li>
							        <li class="dropdown">
								        <a href="#" class="dropdown-toggle user-menu" data-toggle="dropdown">
									        <img src="../assets/images/rc-images/profile_1.png" alt="">
									        <span><asp:Label ID="lblFullName" runat="server" text="Peter M. Ramos"></asp:Label></span>
								        </a>
								        <ul class="dropdown-menu">
									        <li>
                                                <asp:LinkButton ID="lnkLogout" runat="server"><i class="dropdown-icon fa fa-power-off"></i>&nbsp;&nbsp;Log Out</asp:LinkButton>
									        </li>
								        </ul>
							        </li>
						        </ul> <!-- / .navbar-nav -->
					        </div> <!-- / .right -->
				        </div>
			        </div> <!-- / #main-navbar-collapse -->
		        </div> <!-- / .navbar-inner -->
	        </div> <!-- / #main-navbar -->

	        <div id="main-menu" role="navigation">
		        <div id="main-menu-inner">
			        <div class="menu-content top" id="menu-content-demo">

				        <div>
					        <div class="text-bg">
                                <span class="text-slim">Welcome,</span><br /> 
                                <span class="text-semibold"><asp:Label ID="lblFName" runat="server" Text="Peter"></asp:Label></span>
					        </div>
					        <img src="../assets/images/rc-images/profile_1.png" alt="" class="">
				        </div>
			        </div>
			        <ul class="navigation">
				        <li>
					        <a href="../admin-dashboard" id="btnDashboard" runat="server" visible="true"><i class="menu-icon fa fa-dashboard" ></i><span class="mm-text">Dashboard</span></a>
				        </li>
                        <li>
                            <% if(Convert.ToInt32(Session["UserTypeID"])==3 )%>
                            <%{%>
					        <a href="../grade-level" id="btnGradeLevel" runat="server" visible="true"><i class="menu-icon  fa fa-building-o"></i><span class="mm-text">Grade Level</span></a>
                            <%}%>
				        </li>
                        <li><% if(Convert.ToInt32(Session["UserTypeID"])==3 )%>
                            <%{%>
					        <a href="../enroll-schools" id="btnSchools" runat="server" visible="true"><i class="menu-icon  fa fa-building-o"></i><span class="mm-text">Enroll Schools</span></a>
                            <%}%>
				        </li>
                        <li>
                            <% if(Convert.ToInt32(Session["UserTypeID"])==3 )%>
                            <%{%>
					        <a href="../create-sections" id="btnSections" runat="server" visible="true"><i class="menu-icon  fa fa-building-o"></i><span class="mm-text">Create Sections</span></a>
                            <%}%>
				        </li>
                        <li><% if(Convert.ToInt32(Session["UserTypeID"])==3 )%>
                            <%{%>
					        <a href="../enroll-teachers" id="btnTeacher" runat="server" visible="true"><i class="menu-icon  fa fa-user-md"></i><span class="mm-text">Enroll Teachers</span></a>
                            <%}%>
				        </li>
                        <li>
                            <% if(Convert.ToInt32(Session["UserTypeID"])==3 )%>
                            <%{%>
					        <a href="../enroll-students" id="btnStudents" runat="server" visible="true"><i class="menu-icon  fa fa-users"></i><span class="mm-text">Enroll Students</span></a>
                            <%}%>
				        </li>
                        <li>
                            <% if(Convert.ToInt32(Session["UserTypeID"])==3 )%>
                            <%{%>
					        <a href="../enroll-admin" id="btnAdmin" runat="server" visible="true"><i class="menu-icon  fa fa-user"></i><span class="mm-text">Enroll Admin</span></a>
                            <%}%>
				        </li>
                        <% if (Convert.ToInt32(Session["UserTypeID"]) == 3 || Convert.ToInt32(Session["UserTypeID"]) == 4)%>
                            <%{%>
                        <li class="mm-dropdown" id="btnCards" runat="server" visible="true">
                            <a href="#"><i class="menu-icon fa fa-question-circle" ></i><span class="mm-text">Questionaire</span></a>
                            <ul>
                                <% if(Convert.ToInt32(Session["UserTypeID"])==3 )%>
                                <%{%>
                                <li>
							        <a tabindex="-1" href="../group-lessons" id="btnGroupLessons" runat="server" visible="true"><span class="mm-text">Lessons Group</span></a>
						        </li>
                                
                                <li>
							        <a tabindex="-1" href="../create-lessons" id="btnItems" runat="server" visible="true"><span class="mm-text">Lessons</span></a>
						        </li>
                                <li>
							        <a tabindex="-1" href="../create-question-description" id="btnItemCategory" runat="server" visible="true"><span class="mm-text">Description</span></a>
						        </li>
                                <%}%>
                                <% if(Convert.ToInt32(Session["UserTypeID"])==3 || Convert.ToInt32(Session["UserTypeID"])==4)  %>
                                <%{%>
                                <li>
							        <a tabindex="-1" href="../create-questionnaire" id="btnProjects" runat="server" visible="true"><span class="mm-text">Question</span></a>
						        </li>
                                <%}%>
                            </ul> 
                        </li>
                        <%}%>
                         <li>
					        <a href="../teacher-usage" id="A1" runat="server" visible="true"><i class="menu-icon  fa fa-bar-chart-o"></i><span class="mm-text">Teacher Usage</span></a>
				        </li>
			        </ul> <!-- / .navigation -->
                    <% if(Convert.ToInt32(Session["UserTypeID"])==3 )%>
                    <%{%>
                    <div class="menu-content animated fadeIn">
				        <a href="../create-questionnaire?start=true" class="btn btn-primary btn-block btn-outline">Create Questionnaire</a>
			        </div>
                    <%}%>
		        </div> <!-- / #main-menu-inner -->
	        </div> <!-- / #main-menu -->
        <!-- /4. $MAIN_MENU -->

	        <div id="content-wrapper">
		        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
        
                </asp:ContentPlaceHolder>
                
	        </div> <!-- / #content-wrapper -->
	        <div id="main-menu-bg"></div>
        </div> <!-- / #main-wrapper -->

        <!-- Get jQuery from Google CDN -->
        <!--[if !IE]> -->
	        <script type="text/javascript"> window.jQuery || document.write('<script src="assets/javascripts/jquery.min.js">' + "<" + "/script>"); </script>
        <!-- <![endif]-->
        <!--[if lte IE 9]>
	        <script type="text/javascript"> window.jQuery || document.write('<script src="assets/javascripts/jquery.min.js">'+"<"+"/script>"); </script>
        <![endif]-->


        <script src="/assets/javascripts/bootstrap.min.js"></script>
        <script src="/assets/javascripts/pixel-admin.min.js"></script>

        <script type="text/javascript">
            init.push(function () {

            })
            window.PixelAdmin.start(init);


            var options2 = {
                orientation: $('body').hasClass('right-to-left') ? "auto right" : 'auto auto'
            }

            $(".dropdownlist-search").select2({
                allowClear: true
            });

            $('#bs-datepicker-range').datepicker(options2);
        </script>

    
    
    <asp:ContentPlaceHolder ID="scripts" runat="server">
    </asp:ContentPlaceHolder>


    </form>
</body>
</html>