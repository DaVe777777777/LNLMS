<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="StudentLesson.master.cs" Inherits="LittleNewton.Web.StudentLesson" %>

<!DOCTYPE html>



<!--[if IE 8]>         <html class="ie8"> <![endif]-->
<!--[if IE 9]>         <html class="ie9 gt-ie8"> <![endif]-->
<!--[if gt IE 9]><!--> <html class="gt-ie8 gt-ie9 not-ie"> <!--<![endif]-->
<head>
	<meta charset="utf-8">
	<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
	<title>Little Newton - Student</title>
	<%--<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0">--%>

	<!-- Open Sans font from Google CDN -->
	<link href="https://fonts.googleapis.com/css?family=Open+Sans:300italic,400italic,600italic,700italic,400,600,700,300&subset=latin" rel="stylesheet" type="text/css">

	<!-- Pixel Admin's stylesheets -->
	<link href="assets/stylesheets/bootstrap.min.css" rel="stylesheet" type="text/css">
	<link href="assets/stylesheets/pixel-admin.min.css" rel="stylesheet" type="text/css">
	<link href="assets/stylesheets/widgets.min.css" rel="stylesheet" type="text/css">
	<link href="assets/stylesheets/pages.min.css" rel="stylesheet" type="text/css">
	<link href="assets/stylesheets/rtl.min.css" rel="stylesheet" type="text/css">
	<link href="assets/stylesheets/themes.min.css" rel="stylesheet" type="text/css">
    <link href="assets/Content/css/custom.css" rel="stylesheet" type="text/css">

</head>

<body class="theme-default main-menu-animated">

<form id="form1" runat="server">
<script>var init = [];</script>
    <div id="content-bg"><img src="assets/imgs/bg.jpg"/></div>
    <div id="wrapper">
        <div id="main-nav">
            <div id="brand-name" class="pull-left">
                <span style="float:left;"><img src="assets/imgs/logo.png" class="img-responsive" style="position:absolute;" /></span>
            </div>
            
            <ul id="nav-menu">
                <a href="../student-dashboard">
                    <li>
                        <i class="menu-icon fa fa-dashboard"></i>&nbsp; <span class="nav-name">Dashboard </span>
                    </li>
                </a>
                <a href="../skillmap-random-trials">
                    <li>
                        <i class="menu-icon fa fa-puzzle-piece"></i>&nbsp; <span class="nav-name">Challenge Yourself </span> 
                    </li>
                </a>
                <a href="../skillmap" >
                    <li>
                        <i class="menu-icon fa  fa-lightbulb-o"></i>&nbsp; <span class="nav-name">Classroom Lesson </span> 
                    </li>
                </a>
                <a href="../student-worksheet" >
                    <li>
                        <i class="menu-icon fa fa-home"></i>&nbsp; <span class="nav-name">Online Worksheet</span>
                    </li>
                </a>
                 <a href="../skillmap-super-challenge" >
                    <li>
                        <i class="menu-icon fa fa-puzzle-piece"></i>&nbsp; <span class="nav-name">Super Challenge</span>
                    </li>
                </a>
            </ul>

            <ul id="profile-name" class="pull-right">
                <li id="message-wrapper">
                    <a href="#" id="message-toggle"><i class="menu-icon fa fa-bell"></i></a>
                    <span class="label bg-danger notification-count"><%= MessageCount %></span>
                    <div class="messages-container">
                          <asp:Repeater ID="rpList" runat="server">
                            <ItemTemplate>
                                <div class="message-item">
                                    <asp:HiddenField ID="hfMsgID" runat="server" Value='<%# Eval("ID") %>' />
                                    <span class="message-subject"><%# Eval("SubjectShort") %></span>
                                    
                                    <span class="message-date"><%# Eval("DateCreated","{0:d}") %> <asp:LinkButton ID="lnkOpen" runat="server" OnClick="Transaction_Click" CommandName="Open" CommandArgument='<%# Eval("ID")%>'><span class="btnOpenMessage pull-right">Open</span></asp:LinkButton></span>
                                    <div class="message-from"><i><%# Eval("MessageFrom") %> </i></div>
                                </div>
                            </ItemTemplate>
                        </asp:Repeater>
                    </div>

				</li>
				<li class="dropdown">
                        <a href="#" class="dropdown-toggle user-menu" data-toggle="dropdown">
						<span><asp:Label ID="lblFullName" runat="server" Text="John Cruz"></asp:Label></span>
					</a>
					<ul class="dropdown-menu"style="height:50px;padding:6px 1px 0 1px; ">
						<li>
                            <asp:LinkButton ID="lnkLogout" style="margin-top:-53px; " runat="server">&nbsp;&nbsp;Log Out</asp:LinkButton>
						</li>
					</ul>
				</li>
			</ul>
        </div>
        
        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                        
        </asp:ContentPlaceHolder>
    </div> 

</form>
    <div class="branding">
        Copyright © <asp:Label ID="lblCopyright" runat="server"/> Leaderscom. Designed & Developed by: <a href="http://programositsolutions.com/" target="_blank" >PROGRAMOS IT SOLUTIONS</a>
    </div>
<!-- Pixel Admin's javascripts -->
<script src="assets/Content/js/jQuery-2.1.4.min.js"></script>
<script src="assets/javascripts/bootstrap.min.js"></script>
<script src="assets/javascripts/pixel-admin.min.js"></script>

<script type="text/javascript">

    function hide2ndAnswer() {
        $('.2nd-answer').hide();
    }
    function show2ndAnswer() {
        $('.2nd-answer').show();
    }

    init.push(function () {
        $("#menu-toggle").click(function (e) {
            console.log("toggled");
            e.preventDefault();
            $("#wrapper").toggleClass("menuDisplayed");
        });
    });


    init.push(function () {
        $("#message-toggle").click(function (e) {
            console.log("toggled");
            e.preventDefault();
            $("#message-wrapper").toggleClass("messages-container-toggle");
        });
    });
    window.PixelAdmin.start(init);

    </script>

<asp:ContentPlaceHolder ID="scripts" runat="server">
    </asp:ContentPlaceHolder>

</body>
</html>